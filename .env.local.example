# Copy this file to .env.local and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API
#
# .env.local is git-ignored. This example file is not, and must never contain
# a real value.

# ---------------------------------------------------------------------------
# SAFE IN THE BROWSER
#
# Next.js compiles anything prefixed NEXT_PUBLIC_ into the JavaScript bundle,
# where every visitor can read it. These three are designed for that. What
# protects the data is Row Level Security on the tables, not secrecy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your live domain, e.g. https://ironhaus.iq
# Used for canonical URLs, the sitemap, and social link previews.
# Without it these fall back to http://localhost:3000, which is wrong in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# NEVER EXPOSE
#
# The application does not use either of these — they are listed so you know
# what NOT to add with a NEXT_PUBLIC_ prefix.
#
# service_role bypasses Row Level Security completely. If it reaches browser
# code, anyone can read, edit and delete every booking and customer record.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=
